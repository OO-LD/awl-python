{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/awl/contracts/source-span.schema.json",
  "@context": {
    "awl": "https://w3id.org/awl/schema/",
    "@vocab": "https://w3id.org/awl/schema/"
  },
  "x-oold-version": "0.1.0",
  "title": "SourceSpan",
  "description": "A range in a source file, as produced by ast.co_positions(). The unit of attribution shared by tracing and write-back.",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "description": "Path relative to the scan root."
    },
    "startLine": {
      "type": "integer",
      "minimum": 1
    },
    "startCol": {
      "type": "integer",
      "minimum": 0
    },
    "endLine": {
      "type": "integer",
      "minimum": 1
    },
    "endCol": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "file",
    "startLine",
    "startCol",
    "endLine",
    "endCol"
  ]
}
