{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/awl/contracts/compact-doc.schema.json",
  "@context": {
    "awl": "https://w3id.org/awl/schema/",
    "@vocab": "https://w3id.org/awl/schema/"
  },
  "x-oold-version": "0.1.0",
  "title": "CompactDoc",
  "description": "The compact AST encoding used as the editor model. Three node forms: a typed node, a literal, and a name. Required fields are reconstructed by the decoder, so this form does not carry them. All three forms may additionally carry M5 orderings and an optional span.",
  "type": "object",
  "properties": {},
  "required": [],
  "oneOf": [
    {
      "type": "object",
      "required": [
        "_"
      ],
      "properties": {
        "_": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "description": "Syntactic sibling slot, materialized by M5."
        },
        "argumentIndex": {
          "type": "integer",
          "description": "1..N positional; -1 when named."
        },
        "argumentName": {
          "type": "string"
        },
        "@": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ]
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Optional span [lineno, col, end_lineno, end_col]; the join key for the editor and the trace overlay."
        },
        "_callee": {
          "type": "string",
          "description": "Local name as written; required to expand a collapsed node back to a Call."
        },
        "@type": {
          "type": [
            "string",
            "array"
          ]
        },
        "@context": {
          "type": [
            "object",
            "string",
            "array"
          ]
        }
      },
      "description": "Typed node."
    },
    {
      "type": "object",
      "required": [
        "c"
      ],
      "properties": {
        "c": {},
        "order": {
          "type": "integer",
          "description": "Syntactic sibling slot, materialized by M5."
        },
        "argumentIndex": {
          "type": "integer",
          "description": "1..N positional; -1 when named."
        },
        "argumentName": {
          "type": "string"
        },
        "@": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ]
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Optional span [lineno, col, end_lineno, end_col]; the join key for the editor and the trace overlay."
        }
      },
      "additionalProperties": false,
      "description": "Literal value."
    },
    {
      "type": "object",
      "required": [
        "$"
      ],
      "properties": {
        "$": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "description": "Syntactic sibling slot, materialized by M5."
        },
        "argumentIndex": {
          "type": "integer",
          "description": "1..N positional; -1 when named."
        },
        "argumentName": {
          "type": "string"
        },
        "@": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ]
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Optional span [lineno, col, end_lineno, end_col]; the join key for the editor and the trace overlay."
        }
      },
      "additionalProperties": false,
      "description": "Name reference."
    },
    {
      "type": "object",
      "required": [
        "@type",
        "_callee"
      ],
      "properties": {
        "_": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "description": "Syntactic sibling slot, materialized by M5."
        },
        "argumentIndex": {
          "type": "integer",
          "description": "1..N positional; -1 when named."
        },
        "argumentName": {
          "type": "string"
        },
        "@": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ]
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Optional span [lineno, col, end_lineno, end_col]; the join key for the editor and the trace overlay."
        },
        "_callee": {
          "type": "string",
          "description": "Local name as written; required to expand a collapsed node back to a Call."
        },
        "@type": {
          "type": [
            "string",
            "array"
          ]
        },
        "@context": {
          "type": [
            "object",
            "string",
            "array"
          ]
        }
      },
      "description": "Collapsed typed node. _callee and @ make the collapse reversible."
    }
  ]
}
